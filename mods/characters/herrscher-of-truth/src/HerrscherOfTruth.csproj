<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HerrscherOfTruth</AssemblyName>
    <RootNamespace>SodMod.Characters.HerrscherOfTruth</RootNamespace>
    <Description>Mod loader smoke-test scaffold: character gameplay not yet registered.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dew.Core">
      <HintPath>$(GameManagedDir)/Dew.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="../../../../shared/src/SodModLog.cs" Link="Shared/SodModLog.cs" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set -p:GameDir=... or SOD_GAME_DIR to your installed Shape of Dreams game folder." />
    <Error Condition="'$(GameDir)' != '' and !Exists('$(GameManagedDir)/Dew.Core.dll')" Text="Dew.Core.dll not found under $(GameManagedDir). Check GameDir." />
  </Target>
</Project>
